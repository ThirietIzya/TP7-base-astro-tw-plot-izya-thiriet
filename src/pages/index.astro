---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import GraphNavigation from '../components/GraphNavigation.astro';
import * as Plot from "@observablehq/plot";
import penguins from '../data/penguins.json';

// Graphique 1 : Nuage de points global
const penguinsChartOptions = {
  title: "Longueur des nageoires vs Masse corporelle",
  subtitle: "Comparaison globale de toutes les espèces de la station Palmer",
  caption: "Figure 1. Nuage de points des manchots par espèce.",
  ariaLabel: "Nuage de points représentant la masse corporelle en fonction de la taille des nageoires",
  grid: true,
  inset: 10,
  width: 760,
  height: 420,
  marginLeft: 60,
  marginBottom: 45,
  x: { label: "Longueur des nageoires (mm) →" },
  y: { label: "↑ Masse corporelle (g)" },
  color: { 
    legend: true,
    domain: ["Adelie", "Chinstrap", "Gentoo"],
    range: ["#ea580c", "#9333ea", "#0284c7"]
  },
  marks: [
    Plot.dot(penguins, { 
      x: "flipper_length_mm", 
      y: "body_mass_g", 
      fill: "species",
      stroke: "#ffffff",
      strokeWidth: 1.2,
      r: 5.5,
      fillOpacity: 0.85,
      title: (d) => `Espèce: ${d.species}\nÎle: ${d.island}\nNageoire: ${d.flipper_length_mm}mm\nMasse: ${d.body_mass_g}g`
    })
  ]
};
---

<Layout title="Visualisation de données - Manchots Palmer (TP2)" activeTab="home">
  <div class="space-y-8">
    <!-- En-tête -->
    <div class="text-center space-y-3">
      <span class="inline-block px-3 py-1 bg-pink-100 text-pink-800 border border-pink-300 rounded-full text-xs font-bold uppercase tracking-wider">
        Graphique 1
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Visualisation des données <span class="text-pink-600">Palmer</span>
      </h1>
      <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base">
        Exploration interactive de la morphologie des manchots de l'archipel Palmer avec Observable Plot et Astro.
      </p>
    </div>

    <!-- Carte du Graphique -->
    <section id="penguins-scatter" class="rounded-3xl border-2 border-pink-200 bg-white/95 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-pink-100">
        <h2 class="text-lg sm:text-xl font-extrabold text-slate-900">
          Graphique 1 : Nuage de points multi-espèces
        </h2>
        <span class="text-xs font-semibold text-slate-500 bg-pink-50 px-2.5 py-1 rounded-full border border-pink-200">
          Scatter Plot
        </span>
      </div>

      <figure class="plot-figure-container flex justify-center items-center overflow-x-auto">
        <PlotFigure options={penguinsChartOptions} />
      </figure>
    </section>

    <!-- Liens directs vers les nouveaux exercices du TP -->
    <section class="rounded-3xl border-2 border-pink-200 bg-white/95 p-6 sm:p-8 shadow-sm space-y-4">
      <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
        <span>🚀</span> Nouveaux exercices du TP :
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- 1) Leaflet -->
        <a href="/leaflet" class="block p-4 rounded-2xl border-2 border-pink-100 hover:border-pink-300 hover:bg-pink-50/50 transition-all shadow-xs group">
          <div class="text-xs font-bold uppercase text-pink-700 bg-pink-100 inline-block px-2 py-0.5 rounded-full mb-2">1) Leaflet.js</div>
          <h3 class="font-extrabold text-slate-900 group-hover:text-pink-600">Carte Établissements</h3>
          <p class="text-xs text-slate-500 mt-1">Carte interactive OpenStreetMap centrée sur la France avec marqueurs et popups.</p>
        </a>

        <!-- 2) GeoJSON -->
        <a href="/geojson/client" class="block p-4 rounded-2xl border-2 border-pink-100 hover:border-pink-300 hover:bg-pink-50/50 transition-all shadow-xs group">
          <div class="text-xs font-bold uppercase text-indigo-700 bg-indigo-100/70 inline-block px-2 py-0.5 rounded-full mb-2">2) Astro GeoJSON</div>
          <h3 class="font-extrabold text-slate-900 group-hover:text-pink-600">Carte Choroplèthe Dynamique</h3>
          <p class="text-xs text-slate-500 mt-1">Filtres SELECT côté client (Année, Sexe, Âge) et rendu serveur SSR.</p>
        </a>
      </div>
    </section>

    <!-- Navigation entre les 4 graphiques -->
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Voir les autres graphiques :</span>
      <GraphNavigation current={1} />
    </div>
  </div>
</Layout>